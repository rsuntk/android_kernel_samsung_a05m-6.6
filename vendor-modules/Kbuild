#
# The vendor modules are not a single kbuild unit: each module is built
# through its own Makefile so that the per-module wrapper logic (WLAN
# variants, hbt_driver, conninfra, ...) is preserved.
#
# Use the aggregate target instead:
#
#   make -C kernel-6.6 mtk-vendor-modules
#
# or:
#
#   make -C kernel-6.6/vendor-modules KERNEL_SRC=<kernel> \
#        M=vendor-modules O=<out> modules
